# ---------- Required ----------
ANTHROPIC_API_KEY=sk-ant-...

# Slack (Socket Mode: no public URL needed)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ---------- Optional ----------
# Claude model used by the agent
CLAUDE_MODEL=claude-sonnet-5-5

# Let the agent search the web (needs web search enabled for your API org)
ENABLE_WEB_SEARCH=true

# Channel ID (e.g. C0123456789) where the daily digest is posted. Leave empty to disable.
DIGEST_CHANNEL=
# Cron expression + timezone for the digest (default: 9:00 every day, IST)
DIGEST_CRON=0 9 * * *
TIMEZONE=Asia/Kolkata

# Days after approval before a follow-up reminder fires
FOLLOWUP_DAYS=5
# Hours a draft can sit unapproved before the bot nudges the channel
APPROVAL_TIMEOUT_HOURS=24

# Agent safety limits
AGENT_MAX_TURNS=10
AGENT_TIMEOUT_MS=120000

# Metrics: YOU must measure these (see docs/TEST_LOG.md) before putting numbers on a resume
BASELINE_MANUAL_MINUTES=25
REVIEW_MINUTES=3

# Airtable CRM (optional; if unset, leads are stored in data/leads.json)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads
