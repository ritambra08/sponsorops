  "description": "Agentic Slack assistant that researches prospects, drafts outreach, and tracks the pipeline with human-in-the-loop approval.",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
