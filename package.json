    "smoke": "tsx scripts/smoke.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@slack/bolt": "^5.1.0",
    "@slack/types": "^3.2.0",
    "dotenv": "^18.0.8",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
